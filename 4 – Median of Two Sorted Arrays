class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {

        int count = (nums1.length + nums2.length)/2;

        int i = 0;
        int j = 0;
        int num1 = -1;
        int num2 = -1;

       while(i < nums1.length && j < nums2.length){

        if(nums1[i] < nums2[j]){
           
           
            if(count == 1){
            num1 = nums1[i]; 
            }if(count == 0){
                num2 = nums1[i];
                break;
            }
            i++;
             count--;
        }else{
           
            
            if(count == 1){
            num1 = nums2[j]; 
            }if(count == 0){
                num2 = nums2[j];
                break;
            }
            j++;
            count--;
            
        }
       }
           
       


       while(i < nums1.length){
        
            if(count == 1){
            num1 = nums1[i]; 
            }if(count == 0){
                num2 = nums1[i];
                break;
            }
            i++;
            count--;
       }


       while(j < nums2.length){

           
            if(count == 1){
            num1 = nums2[j]; 
            }if(count == 0){
                num2 = nums2[j];
                break;
            }
            j++;
             count--;
       }

       if((nums1.length + nums2.length) % 2 != 0){
        return (double)num2;
       }

       double ans = ((double)(num1 + num2))/2;

       return ans;

        
    }
}

