

class Solution {
    public int findKthLargest(int[] nums, int k) {

        int max = 0;

        for(int i = 0; i<nums.length; i++){
           int num = Math.abs(nums[i]);
           max = Math.max(num, max);
        }

        int []arr = new int[(max * 2) + 1];


        for(int i = 0; i<nums.length ; i++){
            if(nums[i] < 0){
                arr[max - Math.abs(nums[i])]++;
            }else{
                arr[max + nums[i]]++;
            }
        }

        int index = -1;

        for(int i = arr.length - 1; i>=0; i--){

            while(arr[i] > 0){

                if(k == 0){
                    break;
                }
                k--;
                arr[i]--;
            }

            if(k == 0){
                index = i;
                break;
            }
        }

        return index - max;

        

        
    }
}
